{
  "name": "baby-tracker",
  "private": true,
  "version": "2.49.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "functions:deploy": "supabase functions deploy push-reminders --no-verify-jwt --use-api",
    "check:functions": "for d in supabase/functions/*/; do (cd \"$d\" && deno check --node-modules-dir=auto index.ts) || exit 1; done; rm -rf supabase/functions/*/node_modules supabase/functions/*/deno.lock"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "date-fns": "^4.4.0",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "supabase": "^2.115.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
